{
  "name": "onluyen-fe36-ai",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://devsepa.github.io",
    "GEMINI_MODEL": "gemini-3.5-flash",
    "USER_DAILY_QUESTIONS": "150",
    "GLOBAL_DAILY_QUESTIONS": "1000",
    "PREPARE_PUBLIC_DECKS": "true",
    "AI_IMAGE_INTERVAL_MS": "60000",
    "AI_TEXT_INTERVAL_MS": "15000",
    "MODERATOR_EMAILS": "nguyenduy222.contact@gmail.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_QUOTA",
        "class_name": "AIQuota"
      },
      {
        "name": "SHARED_DECKS",
        "class_name": "SharedDecks"
      },
      {
        "name": "PRIVATE_LIBRARY",
        "class_name": "PrivateLibrary"
      },
      {
        "name": "EXPLANATION_CACHE",
        "class_name": "ExplanationCache"
      },
      {
        "name": "QUALITY_STORE",
        "class_name": "QualityStore"
      },
      {
        "name": "GEMINI_RUNTIME",
        "class_name": "RegionalGemini"
      },
      {
        "name": "AI_WORK_QUEUE",
        "class_name": "AIWorkQueue"
      },
      {
        "name": "DECK_PREPARATION",
        "class_name": "DeckPreparation"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AIQuota"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SharedDecks"
      ]
    },
    {
      "tag": "v3-private-library",
      "new_sqlite_classes": [
        "PrivateLibrary"
      ]
    },
    {
      "tag": "v4-explanation-cache",
      "new_sqlite_classes": [
        "ExplanationCache"
      ]
    },
    {
      "tag": "v5-quality-store",
      "new_sqlite_classes": [
        "QualityStore"
      ]
    },
    {
      "tag": "v6-regional-gemini",
      "new_sqlite_classes": [
        "RegionalGemini"
      ]
    },
    {
      "tag": "v7-ai-preparation",
      "new_sqlite_classes": [
        "AIWorkQueue",
        "DeckPreparation"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
