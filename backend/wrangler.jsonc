{
  "name": "onluyen-fe36-ai",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://devsepa.github.io",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "USER_DAILY_QUESTIONS": "150",
    "GLOBAL_DAILY_QUESTIONS": "1000"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_QUOTA",
        "class_name": "AIQuota"
      },
      {
        "name": "SHARED_DECKS",
        "class_name": "SharedDecks"
      },
      {
        "name": "PRIVATE_LIBRARY",
        "class_name": "PrivateLibrary"
      },
      {
        "name": "EXPLANATION_CACHE",
        "class_name": "ExplanationCache"
      },
      {
        "name": "QUALITY_STORE",
        "class_name": "QualityStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AIQuota"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SharedDecks"
      ]
    },
    {
      "tag": "v3-private-library",
      "new_sqlite_classes": [
        "PrivateLibrary"
      ]
    },
    {
      "tag": "v4-explanation-cache",
      "new_sqlite_classes": [
        "ExplanationCache"
      ]
    },
    {
      "tag": "v5-quality-store",
      "new_sqlite_classes": [
        "QualityStore"
      ]
    }
  ]
}
