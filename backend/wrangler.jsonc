{
  "name": "onluyen-fe36-ai",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://devsepa.github.io",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "USER_DAILY_QUESTIONS": "150",
    "GLOBAL_DAILY_QUESTIONS": "1000"
  },
  "durable_objects": {"bindings": [{"name": "AI_QUOTA", "class_name": "AIQuota"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["AIQuota"]}]
}
